# Base de datos (ya configurada en .env)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ---------- Firebase (Authentication con Google + Firestore) ----------
# Consola: https://console.firebase.google.com
# 1. Crea un proyecto > "Agregar app" > Web. Copia la config del SDK:
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tu-proyecto
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com

# 2. En Authentication > Sign-in method, habilita "Google".
# 3. En Firestore Database > Reglas, publica (para perfiles y estadísticas):
#      match /profiles/{uid} {
#        allow read: if true;
#        allow write: if request.auth != null && request.auth.uid == uid;
#      }

# 4. Para que el servidor VERIFIQUE las sesiones de Google (recomendado;
#    si falta, se usa NEXT_PUBLIC_FIREBASE_PROJECT_ID como respaldo):
FIREBASE_PROJECT_ID=tu-proyecto

# Notas:
# - Las variables NEXT_PUBLIC_* son públicas por diseño (así funciona el SDK web de Firebase).
# - Sin estas variables el juego funciona en "modo invitado" (solo nombre, sin contraseña).
